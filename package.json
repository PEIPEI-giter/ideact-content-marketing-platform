{
  "name": "content-marketing-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx server/index.ts",
    "dev:all": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$api = Start-Process npm -ArgumentList 'run','dev:api' -PassThru; try { npm run dev } finally { Stop-Process -Id $api.Id -ErrorAction SilentlyContinue }\"",
    "verify:models": "tsx server/verify-models.ts",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@alicloud/bailian20231229": "^2.14.4",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0",
    "xml2js": "^0.6.2"
  }
}
